# Staging gateway: one entry point on the LAN that routes to each component.
# Security headers come from each component's own Caddy; the gateway passes
# them through untouched and only hides its own Server header.
#
# Staging-only additions (SCRUM-38), so nobody mistakes staging for the live site:
#   - X-Robots-Tag noindex on every response, and a disallow-all /robots.txt;
#   - /env.css reveals the site's [data-env="staging-only"] elements (the Preview
#     ribbon and the test-order notice). The site image ships an empty /env.css,
#     so the live site never shows them.
# The same gateway answers on the LAN (http://home-server:8088) and through
# Tailscale Serve (https://home-server.<tailnet>.ts.net:8443).
#
# The blog editor (SCRUM-34) has its own listener, :8081, which compose publishes on
# 127.0.0.1 only, for Tailscale Serve (https://home-server.<tailnet>.ts.net:8444).
# The LAN listener (:80) answers 404 for the editor's paths.
#
# The order admin (SCRUM-71/72) likewise: listener :8082, published on 127.0.0.1 only, for
# Tailscale Serve (https://home-server.<tailnet>.ts.net:8445). The LAN listener answers 404 for /admin.
{
	admin off
	auto_https off
}

:80 {
	header X-Robots-Tag "noindex, nofollow"

	# Gateway's own liveness (used by Docker); /healthz is passed to the site.
	handle /gateway-healthz {
		respond "ok" 200
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header X-Content-Type-Options "nosniff"
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	handle /env.css {
		header Content-Type "text/css; charset=utf-8"
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		# In Tailwind's "base" layer on purpose: Tailwind hides [hidden] with an
		# !important rule in that layer, and for !important a layered rule beats an
		# unlayered one, so an unlayered rule here never showed the ribbon (SCRUM-38).
		respond * "@layer base { [data-env=\"staging-only\"][hidden] { display: block !important; } }" 200
	}

	# Never the blog editor on this listener (SCRUM-34): it is Tailscale-only, on :8081.
	# (Path handles sort by specificity, so these win over /api/* below.)
	handle /keystatic* {
		respond "Not found" 404
	}
	handle /api/keystatic* {
		respond "Not found" 404
	}
	# Never the order admin on this listener (SCRUM-71): it is Tailscale-only, on :8082.
	handle /admin* {
		respond "Not found" 404
	}

	# The integrations service (orders, CRM, payments). If it is down, only /api fails.
	handle /api/* {
		reverse_proxy integrations:8080
	}

	handle {
		reverse_proxy site:80
	}

	header -Server
	log {
		output stdout
		format console
	}
}

# The blog editor (Keystatic, SCRUM-34). Reachable only from this machine (127.0.0.1, see
# compose.staging.yml), which means only through Tailscale Serve:
#   https://home-server.<tailnet>.ts.net:8444 → 127.0.0.1:8101 → here → editor:4321
:8081 {
	header X-Robots-Tag "noindex, nofollow"

	handle /gateway-healthz {
		respond "ok" 200
	}

	handle {
		reverse_proxy editor:4321 {
			# Tailscale Serve terminates HTTPS, so tell the editor its real address: Keystatic
			# builds the GitHub sign-in return URL from these, and Astro trusts them only for
			# the configured host (astro.editor.config.mjs in the site repo).
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {$EDITOR_PUBLIC_HOST}
			header_up X-Forwarded-Port {$EDITOR_PUBLIC_PORT}
		}
	}

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	log {
		output stdout
		format console
	}
}

# The order admin (SCRUM-71/72). Reachable only from this machine (127.0.0.1, see compose.staging.yml),
# which means only through Tailscale Serve:
#   https://home-server.<tailnet>.ts.net:8445 → 127.0.0.1:8100 → here → integrations-admin:8081
# Tailscale Serve strips any Tailscale-User-* headers a client sends and adds the signed-in user's;
# they pass through untouched. integrations believes them only when the connection comes from this
# gateway over the private admin network (that's why the target is the integrations-admin alias, which
# only resolves there), and lets in only the logins in ADMIN_LOGINS. It sets its own no-store, DENY and CSP.
:8082 {
	# (integrations sends its own noindex, no-store, DENY and CSP on every admin response.)
	handle /gateway-healthz {
		respond "ok" 200
	}

	# Only the admin's own paths; nothing else of integrations is on this listener.
	handle /admin* {
		reverse_proxy integrations-admin:8081
	}

	handle {
		respond "Not found" 404
	}

	header -Server
	log {
		output stdout
		format console
	}
}
