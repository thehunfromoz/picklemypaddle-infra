[Unit]
Description=PickleMyPaddle staging: pull new images, health-check, roll back if unhealthy
Documentation=https://github.com/thehunfromoz/picklemypaddle-infra/blob/main/runbooks/staging-home-server.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=STACK_DIR=/opt/picklemypaddle/staging
Environment=STATE_DIR=/var/lib/pmp-staging
# Keep Docker's client config (and any later registry login) out of /root.
Environment=DOCKER_CONFIG=/var/lib/pmp-staging/docker
StateDirectory=pmp-staging
ExecStart=/opt/picklemypaddle/staging/update.sh
# SCRUM-88: room for a slow smoke-image pull, the 2-minute health check and the 10-minute smoke
# budget (15 min once killed a deploy mid-test). If it is ever reached, update.sh puts the old
# image back on SIGTERM; TimeoutStopSec gives it time to do so before SIGKILL.
TimeoutStartSec=45min
TimeoutStopSec=2min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
