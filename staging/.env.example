# Staging settings for home-server. install.sh copies this to
# /opt/picklemypaddle/staging/.env the first time; edit that copy, not this file.
# No secrets belong here (SCRUM-18 adds a separate secrets file).

# Port the site is served on: http://home-server:8088
# Ports 80/443 aren't used because Tailscale and other containers share the box.
STAGING_PORT=8088

# Interface to listen on. 0.0.0.0 = LAN and Tailscale; 192.168.1.24 = LAN only.
STAGING_BIND=0.0.0.0

# Images to run. Only change these to test a specific build.
SITE_IMAGE=ghcr.io/thehunfromoz/picklemypaddle-site:staging

INTEGRATIONS_IMAGE=ghcr.io/thehunfromoz/picklemypaddle-integrations:staging

# The blog editor (Keystatic, SCRUM-34): staging only, Tailscale only.
EDITOR_IMAGE=ghcr.io/thehunfromoz/picklemypaddle-site-editor:staging

# The updater keeps every service labelled com.picklemypaddle.autoupdate=true in
# compose.staging.yml current (site, integrations and editor).

# Seconds to wait for a new container to report healthy before rolling back.
HEALTH_TIMEOUT=120

# Components whose smoke-test image (<image>-smoke:<commit>) runs after each
# deploy (SCRUM-17); a failure rolls back like a failed health check.
SMOKE_SERVICES=site
SMOKE_TIMEOUT=600

# Link shown on the GitHub "staging/home-server" commit status.
# install.sh --tailscale switches it to the tailnet address (and --tailscale-off back).
STAGING_PUBLIC_URL=http://home-server:8088

# Every address staging is opened from, comma-separated (the integrations service
# only accepts browser calls from these). install.sh --tailscale adds the tailnet one.
STAGING_SITE_ORIGINS=http://home-server:8088

# HTTPS port Tailscale Serve uses for staging (SCRUM-38). 443 belongs to another app.
TAILSCALE_HTTPS_PORT=8443

# The blog editor (SCRUM-34), only ever over Tailscale:
#   https://<EDITOR_PUBLIC_HOST>:<TAILSCALE_EDITOR_HTTPS_PORT>/keystatic
# Tailscale Serve forwards that port to the gateway's loopback-only port, EDITOR_LOCAL_PORT.
# The host and port must match the editor image's build and the GitHub App's callback URL.
TAILSCALE_EDITOR_HTTPS_PORT=8444
EDITOR_LOCAL_PORT=8089
EDITOR_PUBLIC_HOST=home-server.tail8bc7ae.ts.net
# The GitHub token itself is NOT kept here: install.sh --set-token stores it in
# /etc/picklemypaddle/github-status.token (root-only).

# API keys for the integrations service (Stripe/HubSpot, TEST-MODE on staging) are
# NOT kept here either: they live in this root-only file, created by install.sh.
INTEGRATIONS_ENV_FILE=/etc/picklemypaddle/integrations.env

# The order database's password (SCRUM-64), in its own root-only file created by install.sh.
POSTGRES_ENV_FILE=/etc/picklemypaddle/postgres.env

# Orders per IP per hour on staging (SCRUM-67). Smoke tests, Tailscale visitors and your own
# tests all arrive from the same Docker bridge address, so staging allows more than production's 5.
STAGING_ORDER_LIMIT_PER_IP_HOUR=60

# Nightly backups (SCRUM-64): where they're written on home-server, and how many days are kept.
BACKUP_DIR=/var/backups/picklemypaddle/staging
BACKUP_KEEP_DAYS=30

# The editor's GitHub App ID and secret and its session key (SCRUM-34) are kept in this
# root-only file, created by install.sh; set the App's values with install.sh --set-editor-app.
EDITOR_ENV_FILE=/etc/picklemypaddle/editor.env

# The order admin (SCRUM-71/72), only ever over Tailscale:
#   https://<EDITOR_PUBLIC_HOST>:<TAILSCALE_ADMIN_HTTPS_PORT>/admin
# Tailscale Serve forwards that port to the gateway's loopback-only port, ADMIN_LOCAL_PORT.
# Who may sign in (ADMIN_LOGINS) is in the integrations secrets file: sudo ./staging/install.sh --set-admin-logins
TAILSCALE_ADMIN_HTTPS_PORT=8445
ADMIN_LOCAL_PORT=8090
