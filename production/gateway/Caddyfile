# Production gateway (SCRUM-19): the only thing on the VPS that faces the internet.
#
# Caddy gets and renews Let's Encrypt certificates by itself for every hostname below,
# and redirects http:// to https://. The names come from the container environment
# (SITE_DOMAIN; compose.production.yml), so CI can run the same file on "localhost".
#
#   <domain>       ──► 301 to https://www.<domain>   (www is the canonical address)
#   www.<domain>   ──► site                           (later: /api/* ──► integrations)
#
# Security headers come from the site's own Caddy and pass through untouched. The
# gateway only adds HSTS to what it answers itself, and hides its own Server header.
# Unlike staging, nothing here says noindex: production is meant to be found.
{
	admin off
	email {$ACME_EMAIL:sales@picklemypaddle.com}
}

# Docker's health check only. Plain HTTP on a loopback port that compose does not publish,
# so it never competes with the HTTPS sites below or gets redirected.
http://:8081 {
	bind 127.0.0.1
	handle /gateway-healthz {
		respond "ok" 200
	}
}

{$SITE_DOMAIN:picklemypaddle.com} {
	header Strict-Transport-Security "{$HSTS:max-age=86400}"
	header -Server

	handle /gateway-healthz {
		respond "ok" 200
	}

	handle {
		redir https://www.{$SITE_DOMAIN:picklemypaddle.com}{uri} permanent
	}

	log {
		output stdout
		format console
	}
}

www.{$SITE_DOMAIN:picklemypaddle.com} {
	handle /gateway-healthz {
		respond "ok" 200
	}

	# SCRUM-8/9 (integrations) will add:  handle /api/* { reverse_proxy integrations:8080 }

	handle {
		reverse_proxy site:80
	}

	# The site is stopped, restarting, or not deployed yet: a plain 503, not indexed or cached.
	handle_errors {
		header Strict-Transport-Security "{$HSTS:max-age=86400}"
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		header X-Content-Type-Options "nosniff"
		header Retry-After "30"
		header Content-Type "text/plain; charset=utf-8"
		respond "PickleMyPaddle is temporarily unavailable. Please try again in a few minutes." 503
	}

	header -Server
	log {
		output stdout
		format console
	}
}
