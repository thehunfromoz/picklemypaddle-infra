# Production gateway (SCRUM-19): the only thing on the VPS that faces the internet.
#
# Caddy gets and renews Let's Encrypt certificates by itself for every hostname in the
# site files, and redirects http:// to https://. It can serve several websites: each one is
# a file in sites/ (one per site, imported below), so adding a site never touches this file
# or another site's file. See runbooks/production-ovh-vps.md, "Adding another website".
#
#   sites/picklemypaddle.caddy   picklemypaddle.com  ──► 301 to www;  www ──► the site
#
# Security headers come from each site's own Caddy and pass through untouched. The
# gateway only adds HSTS to what it answers itself, and hides its own Server header.
# Unlike staging, nothing here says noindex: production is meant to be found.
{
	admin off
	email {$ACME_EMAIL:sales@picklemypaddle.com}
}

# Docker's health check only. Plain HTTP on a loopback port that compose does not publish,
# so it never competes with the HTTPS sites below or gets redirected.
http://:8081 {
	bind 127.0.0.1
	handle /gateway-healthz {
		respond "ok" 200
	}
}

# The order admin (SCRUM-71/72). Plain HTTP on a container port that compose publishes on the
# host's loopback ONLY (127.0.0.1:8090), for Tailscale Serve on this machine:
#   https://pmp-prod.<tailnet>.ts.net ─► Tailscale Serve ─► 127.0.0.1:8090 ─► here ─► pmp-integrations-admin:8081
# Serve strips any Tailscale-User-* headers a client sends and adds the signed-in user's; they pass
# through untouched. integrations believes them only from this gateway on the private admin network
# (the pmp-integrations-admin alias only resolves there) and lets in only ADMIN_LOGINS.
# Closed (503) until orders are switched on, like /api/*.
http://:8082 {
	handle /gateway-healthz {
		respond "ok" 200
	}

	handle /admin* {
		@closed expression `"{$PMP_ORDERS:closed}" != "open"`
		header @closed {
			Content-Type "text/plain; charset=utf-8"
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
			X-Frame-Options "DENY"
		}
		respond @closed "The order admin is off until orders are switched on (runbooks/production-ovh-vps.md)." 503
		reverse_proxy pmp-integrations-admin:8081
	}

	handle {
		respond "Not found" 404
	}

	header -Server
	log {
		output stdout
		format console
	}
}

# One file per website. A file that does not end in .caddy is ignored.
import /etc/caddy/sites/*.caddy
