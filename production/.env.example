# Production settings for the OVH VPS. install.sh copies this to
# /opt/picklemypaddle/production/.env the first time; edit that copy, not this file.
# No secrets belong here (the integrations service's keys will live in a separate
# root-only file when that service is added).

# The public name. www.<domain> is the canonical address and <domain> redirects to it;
# Caddy gets a certificate for both. Both need an A record that points at this server
# (Cloudflare "DNS only", not proxied, so Caddy can answer the certificate challenge).
SITE_DOMAIN=picklemypaddle.com

# Contact address Caddy gives the certificate authority. Replies are not needed.
ACME_EMAIL=sales@picklemypaddle.com

# HTTP Strict Transport Security: tells browsers to use https only. Starts at one day so a
# mistake can be undone. After a week of clean HTTPS, raise it to a year (keep the quotes):
#   HSTS="max-age=31536000; includeSubDomains"
# includeSubDomains covers every future subdomain of the domain, so only use it once any
# subdomain you add (analytics, CMS...) is served over HTTPS too.
HSTS=max-age=86400

# The site image and the release it runs. update.sh writes SITE_VERSION after a deploy
# passes its checks; leave it empty until the first release is deployed. Production only
# ever runs release tags (vX.Y.Z), never :staging or a commit tag.
SITE_IMAGE_REPO=ghcr.io/thehunfromoz/picklemypaddle-site
SITE_VERSION=

# Seconds to wait for a new site container to report healthy before rolling back.
HEALTH_TIMEOUT=120

# ── Orders (SCRUM-64 to 68). OFF until SCRUM-8 and the security epic SCRUM-21 are signed off. ──
# To switch on, follow runbooks/production-ovh-vps.md, "Switching orders on": set both lines below,
# then recreate the gateway. Until then integrations and postgres don't run and /api/* answers 503.
#COMPOSE_PROFILES=orders
PMP_ORDERS=closed
# The integrations release to run (vX.Y.Z), like SITE_VERSION. Empty until orders are switched on.
INTEGRATIONS_IMAGE_REPO=ghcr.io/thehunfromoz/picklemypaddle-integrations
INTEGRATIONS_VERSION=
# Root-only secrets: live keys and DATABASE_URL, and the database password.
INTEGRATIONS_ENV_FILE=/etc/picklemypaddle/integrations.env
POSTGRES_ENV_FILE=/etc/picklemypaddle/postgres.env

# Nightly backups of the order database and photos (SCRUM-64), once orders are on.
BACKUP_DIR=/var/backups/picklemypaddle/production
BACKUP_KEEP_DAYS=30

# ── Order admin (SCRUM-71/72): on the tailnet only, never the public internet ──
# The gateway's admin listener is published on this loopback port only; Tailscale Serve on this
# machine forwards https://pmp-prod.<tailnet>.ts.net to it (runbooks/production-ovh-vps.md).
# Who may sign in (ADMIN_LOGINS) goes in INTEGRATIONS_ENV_FILE. Answers 503 until orders are on.
ADMIN_LOCAL_PORT=8090
ADMIN_URL=https://pmp-prod.tail8bc7ae.ts.net
